<!DOCTYPE html>

<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Detail Film - CHILL</title>


    <!-- FONT -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <!-- FONT AWESOME -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    >

    <title>Detail Film</title>


    <!-- CSS DETAIL -->

    <link
        rel="stylesheet"
        href="lengkap.css"
    >

</head>


<body>


    <!-- DETAIL FILM -->

    <main class="movie-detail">


        <!-- TOMBOL KEMBALI -->

        <button
            class="back-button"
            id="backButton"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Kembali

        </button>


        <!-- BACKDROP -->

        <section class="detail-hero" id="detailHero">

    <div class="detail-overlay"></div>

    <div class="detail-content">

        <h1 id="detailTitle">
            Judul Film
        </h1>

        <div class="detail-buttons">

            <button class="btn-start" id="startButton">
                <i class="fa-solid fa-play"></i>
                Mulai
            </button>

            <button class="btn-add">
                <i class="fa-solid fa-plus"></i>
            </button>

        </div>

    </div>

</section>


        <!-- INFORMASI FILM -->

        <section class="detail-info">

            <div class="detail-left">

                <div class="movie-meta">

                    <span id="detailYear">
                        2026
                    </span>

                    <span id="detailDuration">
                        109 min
                    </span>

                    <span id="detailAge">
                        17+
                    </span>

                </div>


                <p id="detailDescription">

                    Deskripsi film akan muncul
                    di sini.

                </p>

            </div>


            <div class="detail-right">

                <p>

                    <span>
                        Cast
                    </span>

                    :

                    <span id="detailCast">
                    </span>

                </p>


                <p>

                    <span>
                        Genres
                    </span>

                    :

                    <span id="detailGenre">
                    </span>

                </p>


                <p>

                    <span>
                        Pembuat Film
                    </span>

                    :

                    <span id="detailDirector">
                    </span>

                </p>

            </div>

        </section>


        <!-- FILM SERUPA -->

        <section class="similar-section">

            <h2>
                Film Serupa
            </h2>


            <div
                class="similar-container"
                id="similarContainer"
            >

                <!-- DIISI JAVASCRIPT -->

            </div>

        </section>


    </main>


    <!-- JAVASCRIPT -->

    <script src="movie.js"></script>

    <script src="lengkap.js"></script>

</body>

</html>